# Development / production environment variables for ABA Uganda
# Copy this file to .env and edit the values before running the app.

SECRET_KEY=dev-insecure-change-me-in-production
DEBUG=True
BASE_DOMAIN=abacash.loan
PUBLIC_DOMAIN=abacash.loan
SITE_URL=https://abacash.loan

DB_NAME=lendip_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Optional; when set, DATABASE_URL takes precedence over the DB_* values above.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/lendip_db

REDIS_URL=redis://127.0.0.1:6379/0

AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=ABAUGANDA

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+256785230670

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_PROVIDER can be console, smtp, or gmail_api.
# GOOGLE_SENDER_EMAIL and the OAuth token file are set by:
# python manage.py configure_gmail_oauth --client-secrets "C:\path\to\client_secret.json" --sender-email "sender@example.com"
# GOOGLE_OAUTH_TOKEN_FILE=google_oauth_token.json

ADMINS=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
INTERNAL_IPS=127.0.0.1
